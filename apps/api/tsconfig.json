{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@dagingpeople/contracts": ["../../packages/api/src/types.ts"],
      "@dagingpeople/format": ["../../packages/api/src/format.ts"],
      "@dagingpeople/routes": ["../../packages/api/src/routes.ts"],
      "@dagingpeople/payroll-engine": ["../../packages/payroll-engine/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
