{
  "name": "@dagingpeople/api-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend HRIS DagingPeople: NestJS modular monolith + PostgreSQL + pg-boss. Payroll Engine sebagai pure-function library.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/seed/cli.ts",
    "admin": "tsx --env-file-if-exists=.env src/admin/cli.ts",
    "test:sql": "psql -v ON_ERROR_STOP=1 -f db/tests/schema.test.sql",
    "test": "tsx test/support/prepare-template.ts && tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:offline": "tsc -p tsconfig.offline.json --noEmit"
  },
  "dependencies": {
    "@dagingpeople/api": "*",
    "@dagingpeople/payroll-engine": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "pg": "^8.13.0",
    "pg-boss": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
